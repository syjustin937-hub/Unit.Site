# ============ Discord ============
DISCORD_TOKEN=

# The bot works ONLY inside this server (required)
GUILD_ID=

# Members must put this link in their Discord custom status to use the bot
REQUIRED_INVITE=
INVITE_URL=

OWNER_ID=
FEEDBACK_CHANNEL_ID=
DONATE_URL=

# ============ Google Gemini AI (a!ai / a!explain) ============
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=60000

# ============ Private Dumper Backend ============
BYPASS_API_URL=
BYPASS_API_TIMEOUT=300000
BYPASS_TIMEOUT=300000

# ============ Deobfuscation / Dumper (LeakD API) ============
LEAKD_API_URL=
DEOBFUSCATION_GUILD_ID=
DEOBF_API_TIMEOUT=180000
DEOBF_DOWNLOAD_TIMEOUT=30000
DEOBF_MAX_FILE_BYTES=8388608
DEOBF_COOLDOWN=15000
DEOBF_MAX_CONCURRENT=3

# Pastefy (never commit a real key)
PASTEFY_API_KEY=

DEOBF_DEBUG=false

# --- local bypass engines ---
# Optional page proxy for work.ink when the host IP is challenged by Cloudflare
WORKINK_PAGE_PROXY=
# Anti-bot relay used by the work.ink engine
WORKINK_RELAY=
# Linkvertise publisher access token (required by the Linkvertise engine)
LINKVERTISE_TOKEN=

# --- link generator (a!g-<service>) ---
GENLINK_BASE_URL=
GENLINK_ORIGIN=
# one link per minute, five links per user per day (owner is exempt)
GENLINK_COOLDOWN=60000
GENLINK_DAILY_LIMIT=5
